{
  "name": "@specs-feup/metafor-autopar",
  "version": "0.0.2",
  "author": "Afonso Osório",
  "description": "Metafor package for automatic parallelization of DO loops.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./*.js": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js"
    }
  },
  "files": [
    "dist",
    "fortran",
    "scripts",
    "src",
    ".gitignore",
    "LICENSE",
    "package-lock.json",
    "package.json",
    "tsconfig.json"
  ],
  "dependencies": {
    "@specs-feup/lara": "~3.5.1",
    "@specs-feup/metafor": "^22.2.1",
    "mathjs": "^15.2.0"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "typescript": "^6.0.2"
  },
  "scripts": {
    "build": "npx tsc",
    "build:watch": "npm run build -- --watch",
    "pretest": "npm run build",
    "test": "node --test"
  }
}
